{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HypnoAI",
  "version": "0.1.0",
  "identifier": "ai.hypnoai.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HypnoAI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "all": false,
      "execute": false,
      "sidecar": true,
      "open": false,
      "scope": [
        {
          "name": "hypnoai-sidecar",
          "sidecar": true,
          "args": true
        }
      ]
    }
  }
}
